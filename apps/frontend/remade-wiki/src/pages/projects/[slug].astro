---
import CopyBadgeDropdown from "../../components/badges/CopyBadgeDropdown";
import ProjectPage from "../../components/pages/ProjectPage";
import Layout from "../../layouts/Layout.astro";
import { loadCatalog, loadMetadata } from "../../lib/catalog";

export async function getStaticPaths() {
	const catalog = await loadCatalog();

	return catalog.projects.map((project) => ({
		params: { slug: project.slug },
		props: { project, catalog },
	}));
}

const { project, catalog } = Astro.props;
const metadata = await loadMetadata();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout description={project.description} index title={project.name}>
	<ProjectPage catalog={catalog} metadata={metadata} project={project}>
		<CopyBadgeDropdown projectUrl={canonical} client:load />
	</ProjectPage>
</Layout>

<script>
import { initializeScreenshotGalleries } from "../../lib/screenshot-gallery-client";

initializeScreenshotGalleries();
</script>
