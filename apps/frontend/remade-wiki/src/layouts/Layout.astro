---
import "../styles/global.css";
import AuthMenu from "../components/auth/AuthMenu";
import Footer from "../components/navigation/Footer";
import Header from "../components/navigation/Header";

interface Props {
	title: string;
	description?: string;
	index?: boolean;
	noindex?: boolean;
}

const {
	title,
	description = "Discover independently developed software reimplementations. Everything can be remade.",
	index = false,
	noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta content="width=device-width" name="viewport">
		<title>
			{title === "Remade"
				? "Remade | Everything can be remade."
				: `${title} · Remade`}
		</title>
		<meta content={description} name="description">
		{noindex && <meta content="noindex, follow" name="robots" />}
		<link href={canonical} rel="canonical">
		<link href="/llms.txt" rel="describedby" type="text/plain">
		<link href="/favicon.svg" rel="icon" type="image/svg+xml">
		<link href="/favicon.ico" rel="icon">
		<link href="/apple-touch-icon.png" rel="apple-touch-icon">
		<meta content={title} property="og:title">
		<meta content={description} property="og:description">
		<meta content="website" property="og:type">
		<meta content={canonical} property="og:url">
		<meta
			content={new URL("/web-app-manifest-512x512.png", Astro.site)}
			property="og:image"
		>
		<meta content="#15191F" name="theme-color">
	</head>
	<body>
		<a
			class="absolute -top-24 left-4 z-10 bg-lime p-3 text-canvas focus:top-3"
			href="#main"
		>
			Skip to content
		</a>
		{import.meta.env.DEV && (
			<div
				class="border-b border-line bg-deep px-4 py-2 text-center text-xs text-muted"
				data-pagefind-ignore
			>
				Local design preview. Login, counters and request delivery are
				simulated. No public writes.
			</div>
		)}
		<Header pathname={Astro.url.pathname}>
			<div class="h-[46px] w-[104px] shrink-0" data-auth-host>
				<AuthMenu client:load />
			</div>
		</Header>
		<main
			class="mx-auto min-h-[65vh] max-w-[1228px] px-[18px] pb-[72px] sm:px-6"
			data-pagefind-body={index ? "" : undefined}
			data-pagefind-ignore={!index ? "" : undefined}
			id="main"
		>
			<slot />
		</main>
		<Footer />
	</body>
</html>
<script>
import "../scripts/card-descriptions";

document.addEventListener("keydown", (event) => {
	if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
		const search = document.querySelector<HTMLInputElement>("#site-search");

		if (search) {
			event.preventDefault();
			search.focus();
		}
	}
});
</script>
